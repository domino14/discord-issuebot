# Copy to .env and fill in. Never commit .env.

# Discord Developer Portal > your app > Bot > Reset Token
DISCORD_TOKEN=

# console.anthropic.com > API Keys (Max monthly API credits are claimed into this Console org)
ANTHROPIC_API_KEY=

# github.com/settings/personal-access-tokens > Fine-grained token
# Repository access: only the repos in config.toml. Permissions: Issues = Read and write.
GITHUB_TOKEN=

# Set to 1 for a trial run that never writes to GitHub.
DRY_RUN=0
